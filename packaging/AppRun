#!/bin/sh
# AppImage entry point. The setuid chrome-sandbox helper cannot work from a
# FUSE mount, but Chromium's user-namespace sandbox can, so --no-sandbox is
# only added when unprivileged user namespaces are unavailable.
SELF="$(readlink -f "$0")"
HERE="${SELF%/*}"

export APPDIR="$HERE"
cd "$HERE" || exit 1

if [ -z "${GDK_BACKEND:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  set -- --ozone-platform-hint=auto "$@"
fi

if ! { command -v unshare >/dev/null 2>&1 && unshare --user true 2>/dev/null; }; then
  echo "grok-bot: user namespaces unavailable; starting with --no-sandbox" >&2
  set -- --no-sandbox "$@"
fi

exec "$HERE/usr/bin/grok-bot" --class=grok-bot "$@"
